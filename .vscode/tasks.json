{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Verify Todo database model",
			"type": "shell",
			"command": "C:\\Program Files\\dotnet\\dotnet.exe",
			"args": [
				"ef",
				"migrations",
				"has-pending-model-changes",
				"--project",
				"src/Todo.Infrastructure",
				"--startup-project",
				"src/Todo.Api",
				"--no-build"
			],
			"options": {
				"cwd": "${workspaceFolder}/todo-app-be"
			},
			"problemMatcher": [
				"$msCompile"
			]
		},
		{
			"label": "Generate Purpose migration",
			"type": "shell",
			"command": "C:\\Program Files\\dotnet\\dotnet.exe",
			"args": [
				"ef",
				"migrations",
				"add",
				"AddPurposes",
				"--project",
				"src/Todo.Infrastructure",
				"--startup-project",
				"src/Todo.Api",
				"--output-dir",
				"Persistence/SqlServerMigrations",
				"--no-build"
